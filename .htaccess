# Apache fallback hardening. This site is served by nginx/openresty, which
# already denies dotfiles; keep this file for other deployments.
Options -Indexes

# Never serve the secret/config files directly.
<FilesMatch "(^\.|^config\.php$|^lib\.php$)">
    Require all denied
</FilesMatch>

# The log viewer is a PHP page; deny data files inside the log directory.
<DirectoryMatch "/log/">
    <FilesMatch "\.(log|json|jpg|jpeg|png|csv|txt)$">
        Require all denied
    </FilesMatch>
</DirectoryMatch>
