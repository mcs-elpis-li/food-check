# Food Check external environment template.
#
# IMPORTANT: nginx serves dotfiles in this directory. Do not place real
# secrets in a `.env` file inside the web root. Either use the guarded
# config.secrets.php (default) or copy this file outside the document root
# and point FOOD_CHECK_ENV at it in the PHP-FPM environment.

# Vision-language model (VLM) server
VLM_BASE_URL=https://your-vlm-host.example.com/v1
VLM_MODEL=your-vision-model
VLM_API_KEY=sk_replace_me

# Optional fallback vision model.
VLM_FALLBACK_BASE_URL=
VLM_FALLBACK_MODEL=
VLM_FALLBACK_API_KEY=
VLM_FALLBACK_ENABLED=1
VLM_FALLBACK_TIMEOUT=45
VLM_FALLBACK_DISABLE_THINKING=0

# Convenience aliases used by OpenAI-compatible clients
OPENAI_BASE_URL=https://your-vlm-host.example.com/v1
OPENAI_API_KEY=sk_replace_me
OPENAI_MODEL=your-vision-model

# ---------------------------------------------------------------------------
# PHP backend (vlm-process.php)
# ---------------------------------------------------------------------------

# Shared key for non-same-origin API clients (X-API-Key).
# Generate one with: openssl rand -hex 32
APP_API_KEY=fc_replace_with_a_long_random_value

# Extra origins allowed by CORS (comma-separated). Empty = same-origin only.
APP_ALLOWED_ORIGINS=

# Allow the page itself to call the proxy without an API key.
APP_ALLOW_SAME_ORIGIN=1

# Image preprocessing: longest side sent to the VLM, JPEG quality.
APP_MAX_DIMENSION=1000
APP_JPEG_QUALITY=85

# Per-IP rate limit (0 disables). Window in seconds.
APP_RATE_LIMIT=60
APP_RATE_WINDOW=60

# Optional model tuning.
VLM_TIMEOUT=90
VLM_MAX_TOKENS=2048
VLM_TEMPERATURE=0.2
# Qwen3: skip reasoning tokens so the 2048-token budget is used for JSON.
VLM_DISABLE_THINKING=1
